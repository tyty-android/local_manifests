<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!--Remotes-->
    <remote name="los"          fetch="https://github.com/LineageOS"        revision="lineage-23.2" />
    <remote name="muppets"      fetch="https://github.com/TheMuppets"       revision="lineage-23.2" />
    <remote name="tyty"         fetch="https://github.com/tyty-android"     revision="custom" />

    <!--Devices Trees-->
    <project name="android_device_sony_pdx234"            path="device/sony/pdx234"         remote="tyty"/>
    <project name="android_device_sony_sm8550-common"     path="device/sony/sm8550-common"  remote="tyty"/>
    <project name="vendor_sony_extra"                     path="vendor/sony/extra"          remote="tyty"/>

    <!--Vendors Tree-->
    <project name="proprietary_vendor_sony_pdx234"        path="vendor/sony/pdx234"         remote="tyty"/>
    <project name="proprietary_vendor_sony_sm8550-common" path="vendor/sony/sm8550-common"  remote="tyty"/>

    <!--Kernel Tree-->
    <project name="android_kernel_sony_sm8550"               path="kernel/sony/sm8550"               remote="tyty"/>
    <project name="android_kernel_sony_sm8550-modules"       path="kernel/sony/sm8550-modules"       remote="los"/>
    <project name="android_kernel_sony_sm8550-devicetrees"   path="kernel/sony/sm8550-devicetrees"   remote="los"/>
    <project name="SukiSU-Ultra"                             path="kernel/sony/sm8550/KernelSU"      remote="tyty"/>
</manifest>
